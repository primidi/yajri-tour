---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import StorySection from "../components/StorySection.astro";
import DestinationsSection from "../components/DestinationsSection.astro";
import ItinerarySection from "../components/ItinerarySection.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import FleetSection from "../components/FleetSection.astro";
import FAQSection from "../components/FAQSection.astro";
import FinalCTABand from "../components/FinalCTABand.astro";
import idData from "../i18n/id.json";
---

<BaseLayout
  lang="id"
  title={idData.site.title}
  description={idData.site.description}
>
  <Hero lang="id" />
  <StorySection lang="id" />
  <DestinationsSection lang="id" />
  <ItinerarySection lang="id" />
  <WhyChooseUs lang="id" />
  <FleetSection lang="id" />
  <FAQSection lang="id" />
  <FinalCTABand lang="id" />
</BaseLayout>
