---
interface Props {
  lang: string;
  title: string;
  subtitle: string;
  faqs: {
    qId: string;
    qEn: string;
    aId: string;
    aEn: string;
  }[];
}

const { lang, title, subtitle, faqs } = Astro.props;
---

<div class="mx-auto max-w-7xl">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <span class="text-gold font-display font-bold tracking-widest uppercase text-sm mb-4 block">
      {lang === "en" ? "Need to know" : "Perlu diketahui"}
    </span>
    <h2 class="font-display text-3xl font-bold text-navy sm:text-4xl md:text-5xl">
      {title}
    </h2>
    <p class="mt-4 text-base sm:text-lg text-charcoal/80 font-body">
      {subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {faqs.map((faq) => (
      <div class="bg-white p-8 rounded-2xl shadow-sm border border-navy/5 hover:shadow-md transition-shadow relative overflow-hidden group">
        <!-- Top decorative border -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gold transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
        
        <div class="w-12 h-12 rounded-full bg-sky/10 flex items-center justify-center mb-6 text-sky group-hover:bg-sky group-hover:text-white transition-colors duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        
        <h3 class="font-display text-lg font-bold text-navy mb-4 leading-tight">
          {lang === "en" ? faq.qEn : faq.qId}
        </h3>
        
        <p class="text-charcoal/80 font-body text-sm sm:text-base leading-relaxed">
          {lang === "en" ? faq.aEn : faq.aId}
        </p>
      </div>
    ))}
  </div>
</div>
