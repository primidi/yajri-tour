---
interface Props {
  lang: string;
  title: string;
  subtitle: string;
  faqs: {
    qId: string;
    qEn: string;
    aId: string;
    aEn: string;
  }[];
}

const { lang, title, subtitle, faqs } = Astro.props;
---

<div class="mx-auto max-w-7xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <div class="lg:col-span-4 sticky top-24">
      <h2 class="font-display text-3xl font-bold text-navy sm:text-4xl">
        {title}
      </h2>
      <div class="h-1 w-16 bg-gold mt-6 mb-6"></div>
      <p class="text-base sm:text-lg text-charcoal/80 font-body leading-relaxed">
        {subtitle}
      </p>
    </div>

    <div class="lg:col-span-8 space-y-6">
      {faqs.map((faq, index) => (
        <div class="faq-item-b border-b border-navy/10 pb-6 group">
          <button
            type="button"
            class="faq-toggle-b flex w-full items-start justify-between text-left focus:outline-none"
            aria-expanded={index === 0 ? "true" : "false"}
          >
            <h3 class="font-display text-lg sm:text-xl font-bold text-navy group-hover:text-gold transition-colors pr-4 mt-1">
              {lang === "en" ? faq.qEn : faq.qId}
            </h3>
            <span class="faq-icon-b shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-navy/5 text-navy font-body text-xl font-light transition-transform duration-300">
              {index === 0 ? "−" : "+"}
            </span>
          </button>
          
          <div
            class={`faq-content-b mt-4 text-charcoal/80 font-body text-base leading-relaxed ${index === 0 ? "block" : "hidden"}`}
          >
            <p>{lang === "en" ? faq.aEn : faq.aId}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function setupFaqAccordionB() {
    const toggles = document.querySelectorAll<HTMLButtonElement>(".faq-toggle-b");
    toggles.forEach((btn) => {
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      if (btn.parentNode) {
        btn.parentNode.replaceChild(newBtn, btn);
      }
      
      newBtn.addEventListener("click", () => {
        const item = newBtn.closest(".faq-item-b");
        if (!item) return;

        const content = item.querySelector(".faq-content-b");
        const icon = newBtn.querySelector(".faq-icon-b");
        const isExpanded = newBtn.getAttribute("aria-expanded") === "true";
        
        if (isExpanded) {
          newBtn.setAttribute("aria-expanded", "false");
          content?.classList.add("hidden");
          content?.classList.remove("block");
          if (icon) icon.textContent = "+";
        } else {
          newBtn.setAttribute("aria-expanded", "true");
          content?.classList.remove("hidden");
          content?.classList.add("block");
          if (icon) icon.textContent = "−";
        }
      });
    });
  }
  
  setupFaqAccordionB();
  document.addEventListener("astro:page-load", setupFaqAccordionB);
  
  const observerB = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === "attributes" && mutation.attributeName === "style") {
        const target = mutation.target as HTMLElement;
        if (target.style.display !== "none" && target.dataset.variant === "B") {
          setupFaqAccordionB();
        }
      }
    });
  });
  
  const variantWrapperB = document.querySelector('[data-section="faq"][data-variant="B"]');
  if (variantWrapperB) {
    observerB.observe(variantWrapperB, { attributes: true });
  }
</script>
