---
import SectionSwitcher from "./prototype/SectionSwitcher.astro";
import VariantA from "./why-prototype/VariantA.astro";
import VariantB from "./why-prototype/VariantB.astro";
import VariantC from "./why-prototype/VariantC.astro";

interface Props {
  lang?: string;
}

const { lang = "id" } = Astro.props;

const title = lang === "en" ? "Why Choose Yajri Tour" : "Mengapa Memilih Yajri Tour";
const subtitle =
  lang === "en"
    ? "We prioritize your safety, comfort, and peace of mind on every journey."
    : "Kami mengutamakan keselamatan, kenyamanan, dan ketenangan Anda di setiap perjalanan.";

const features = [
  {
    icon: "M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197M13 7a4 4 0 11-8 0 4 4 0 018 0z",
    titleId: "Kendaraan Privat Ber-AC",
    titleEn: "Private Air-Conditioned Vehicle",
    descId: "Armada pribadi ber-AC yang bersih dan terawat khusus untuk grup Anda.",
    descEn: "Clean, well-maintained private AC vehicle exclusive to your group."
  },
  {
    icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
    titleId: "Pengemudi Profesional & Berpengalaman",
    titleEn: "Professional & Experienced Driver",
    descId: "Pengemudi ramah dan paham rute pegunungan serta jalur Jawa Timur.",
    descEn: "Friendly local driver with deep knowledge of mountain routes."
  },
  {
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    titleId: "BBM, Tol, & Parkir Termasuk",
    titleEn: "Fuel / Tolls / Parking Fees Included",
    descId: "Harga transparan tanpa biaya tersembunyi selama perjalanan.",
    descEn: "Transparent pricing with no hidden costs along your trip."
  },
  {
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
    titleId: "Jadwal Fleksibel",
    titleEn: "Flexible Schedule",
    descId: "Nikmati perjalanan sesuai ritme Anda tanpa rasa terburu-buru.",
    descEn: "Travel at your own comfortable pace without rushing."
  },
  {
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2",
    titleId: "Rencana Perjalanan Kustom",
    titleEn: "Custom Itinerary",
    descId: "Bebas menyesuaikan destinasi dan titik jemput sesuai keinginan.",
    descEn: "Customize destinations and pickup locations as you wish."
  },
  {
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    titleId: "Aman & Nyaman",
    titleEn: "Safe & Comfortable",
    descId: "Standar keselamatan tinggi dan kenyamanan ekstra sepanjang tur.",
    descEn: "High safety standards and premium comfort throughout the tour."
  },
  {
    icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
    titleId: "Air Mineral Gratis",
    titleEn: "Complimentary Mineral Water",
    descId: "Persediaan air mineral selalu siap untuk menjaga hidrasi Anda.",
    descEn: "Fresh mineral water provided to keep you hydrated on the road."
  }
];
---

<section id="why" class="bg-offwhite py-20 px-4 sm:px-6 lg:px-8 border-t border-navy/5 relative pb-32 group/section">
  <!-- IN-PLACE SECTION SWITCHER -->
  <SectionSwitcher 
    sectionKey="why" 
    sectionName="Why Us" 
    variants={[
      { id: 'A', name: 'Icon Grid' },
      { id: 'B', name: 'Editorial Typography' },
      { id: 'C', name: 'Feature Highlights' }
    ]} 
  />

  <div class="mx-auto max-w-7xl relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-display text-3xl font-bold text-navy sm:text-4xl md:text-5xl">
        {title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-charcoal/80 font-body">
        {subtitle}
      </p>
    </div>

    <!-- PROTOTYPE VARIANTS -->
    <div class="prototype-variant" data-section="why" data-variant="A" style="display: none;">
      <VariantA features={features} lang={lang} />
    </div>
    
    <div class="prototype-variant" data-section="why" data-variant="B" style="display: none;">
      <VariantB features={features} lang={lang} />
    </div>
    
    <div class="prototype-variant" data-section="why" data-variant="C" style="display: none;">
      <VariantC features={features} lang={lang} />
    </div>
  </div>
</section>
