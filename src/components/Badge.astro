---
interface Props {
  type: "foreign" | "domestic";
  lang?: string;
}

const { type, lang = "id" } = Astro.props;

const isForeign = type === "foreign";
const label = isForeign
  ? lang === "en"
    ? "Popular with Foreign Travelers"
    : "Populer untuk Wisatawan Mancanegara"
  : lang === "en"
    ? "Popular with Local Travelers"
    : "Populer untuk Wisatawan Lokal";
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold shadow-xs ${
    isForeign
      ? "bg-sky/15 text-sky border border-sky/30"
      : "bg-gold/15 text-navy border border-gold/30"
  }`}
>
  {isForeign ? (
    <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
    </svg>
  ) : (
    <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
      <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
    </svg>
  )}
  <span>{label}</span>
</span>
