---
import type { CollectionEntry } from "astro:content";
import TestimonialCard from "../TestimonialCard.astro";
import { t } from "../../i18n/utils";

interface Props {
  testimonials: CollectionEntry<"testimonials">[];
  lang?: string;
}

const { testimonials, lang = "id" } = Astro.props;

const title = lang === "en" ? "Our Story & Commitment" : "Cerita & Komitmen Kami";
const subtitle =
  lang === "en"
    ? "Delivering safe, personal, and unforgettable travel experiences across East Java."
    : "Menghadirkan pengalaman perjalanan yang aman, personal, dan tak terlupakan di seluruh Jawa Timur.";

const placeholderStory =
  lang === "en"
    ? "PLACEHOLDER — Founded by local guides with years of experience traversing Bromo, Ijen, and Java's hidden gems. We focus on clear communication, flexible timing, and well-maintained private vehicles to ensure your journey is seamless from arrival to departure."
    : "PLACEHOLDER — Didirikan oleh pemandu lokal berpengalaman dalam menjelajahi Bromo, Ijen, dan pesona alam Jawa Timur. Kami mengutamakan komunikasi yang jelas, waktu yang fleksibel, dan armada privat yang terawat agar perjalanan Anda lancar dari awal hingga akhir.";
---

<div class="py-12">
  <div class="text-center max-w-4xl mx-auto mb-16">
    <span class="text-gold font-semibold tracking-widest uppercase text-sm mb-4 block">
      {lang === "en" ? "About Us" : "Tentang Kami"}
    </span>
    <h2 class="font-display text-4xl md:text-6xl font-bold text-navy mb-8 leading-tight">
      {title}
    </h2>
    <p class="text-xl sm:text-2xl text-charcoal/80 font-display italic leading-relaxed">
      "{subtitle}"
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-24">
    <!-- Masonry Layout -->
    <div class="md:col-span-4 h-64 md:h-[400px] bg-navy/10 rounded-2xl p-6 flex flex-col justify-end border border-navy/5 relative overflow-hidden group">
      <div class="absolute inset-0 bg-navy/5 group-hover:bg-navy/10 transition-colors"></div>
      <span class="relative z-10 text-navy font-bold font-display text-2xl">{t(lang, "story.bromoSunrise")}</span>
    </div>
    
    <div class="md:col-span-8 h-auto bg-white rounded-2xl p-8 sm:p-12 border border-navy/10 flex flex-col justify-center shadow-sm relative">
      <div class="absolute top-0 right-0 w-32 h-32 bg-offwhite rounded-bl-full -z-10"></div>
      <p class="text-charcoal/90 text-lg sm:text-xl font-body leading-loose">
        {placeholderStory}
      </p>
    </div>

    <div class="md:col-span-7 h-64 md:h-[300px] bg-navy/10 rounded-2xl p-6 flex flex-col justify-end border border-navy/5 relative overflow-hidden group">
      <div class="absolute inset-0 bg-navy/5 group-hover:bg-navy/10 transition-colors"></div>
      <span class="relative z-10 text-navy font-bold font-display text-2xl">{t(lang, "story.ijenTrekking")}</span>
    </div>

    <div class="md:col-span-5 h-64 md:h-[300px] bg-sky/10 rounded-2xl p-6 flex flex-col justify-end border border-sky/20 relative overflow-hidden group">
      <div class="absolute inset-0 bg-sky/5 group-hover:bg-sky/10 transition-colors"></div>
      <span class="relative z-10 text-navy font-bold font-display text-2xl">{t(lang, "story.premiumFleet")}</span>
    </div>
  </div>

  <!-- Testimonials as a bold stripe -->
  <div class="bg-navy rounded-3xl p-8 sm:p-12 lg:p-16 text-offwhite relative overflow-hidden">
    <div class="absolute top-0 left-0 w-64 h-64 bg-gold/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-64 h-64 bg-sky/10 rounded-full blur-3xl"></div>
    
    <h3 class="font-display text-3xl md:text-4xl font-bold mb-12 relative z-10 text-center">
      {lang === "en" ? "Guest Experiences" : "Pengalaman Tamu"}
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
      {testimonials.map((item) => (
        <div class="bg-offwhite/5 border border-offwhite/10 rounded-2xl p-6 hover:bg-offwhite/10 transition-colors">
          <div class="flex text-gold mb-4 text-sm">
            {Array.from({ length: item.data.rating }).map(() => (
              <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <p class="text-offwhite/90 italic font-body mb-6 text-sm md:text-base">
            "{lang === "en" ? item.data.quoteEn : item.data.quoteId}"
          </p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-offwhite/20 flex items-center justify-center text-offwhite font-bold text-sm">
              {item.data.author.charAt(0)}
            </div>
            <div>
              <p class="text-offwhite font-semibold font-body text-sm">{item.data.author}</p>
              <p class="text-offwhite/60 text-xs">{item.data.location}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
