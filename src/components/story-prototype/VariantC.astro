---
import type { CollectionEntry } from "astro:content";
import TestimonialCard from "../TestimonialCard.astro";
import { t } from "../../i18n/utils";

interface Props {
  testimonials: CollectionEntry<"testimonials">[];
  lang?: string;
}

const { testimonials, lang = "id" } = Astro.props;

const title = lang === "en" ? "Our Story" : "Cerita Kami";
const subtitle =
  lang === "en"
    ? "Delivering safe, personal, and unforgettable travel experiences across East Java."
    : "Menghadirkan pengalaman perjalanan yang aman, personal, dan tak terlupakan di seluruh Jawa Timur.";

const placeholderStory =
  lang === "en"
    ? "PLACEHOLDER — Founded by local guides with years of experience traversing Bromo, Ijen, and Java's hidden gems. We focus on clear communication, flexible timing, and well-maintained private vehicles to ensure your journey is seamless from arrival to departure."
    : "PLACEHOLDER — Didirikan oleh pemandu lokal berpengalaman dalam menjelajahi Bromo, Ijen, dan pesona alam Jawa Timur. Kami mengutamakan komunikasi yang jelas, waktu yang fleksibel, dan armada privat yang terawat agar perjalanan Anda lancar dari awal hingga akhir.";
---

<div class="py-12">
  <div class="flex flex-col lg:flex-row gap-16 mb-20">
    <!-- sticky top context -->
    <div class="lg:w-1/3 lg:sticky lg:top-32 h-fit">
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-navy mb-6">
        {title}
      </h2>
      <div class="w-12 h-1 bg-sky mb-6"></div>
      <p class="text-xl text-navy/80 font-body mb-6">
        {subtitle}
      </p>
      <p class="text-charcoal/80 leading-relaxed font-body">
        {placeholderStory}
      </p>
    </div>

    <!-- Scrollable Gallery -->
    <div class="lg:w-2/3 overflow-hidden">
      <div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 hide-scrollbar">
        <!-- Gallery Item 1 -->
        <div class="snap-center shrink-0 w-[85%] sm:w-[400px] h-[500px] bg-navy rounded-3xl relative overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-t from-navy to-transparent opacity-80 z-10"></div>
          <div class="absolute inset-0">
            <img src="/images/destinations/bromo.jpg" alt="Mount Bromo" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-navy/20"></div>
          </div>
          <div class="absolute bottom-0 left-0 p-8 z-20">
            <p class="text-gold font-semibold uppercase tracking-wider text-sm mb-2">01 / Focus</p>
            <h3 class="text-offwhite font-display text-2xl font-bold">{t(lang, "story.unrushedPacing")}</h3>
          </div>
        </div>

        <!-- Gallery Item 2 -->
        <div class="snap-center shrink-0 w-[85%] sm:w-[400px] h-[500px] bg-offwhite rounded-3xl relative overflow-hidden border border-navy/10 group">
          <div class="absolute inset-0 bg-gradient-to-t from-offwhite/50 to-transparent opacity-90 z-10"></div>
          <div class="absolute inset-0">
            <img src="/images/fleet/interior.jpg" alt="Fleet Interior" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-navy/10"></div>
          </div>
          <div class="absolute bottom-0 left-0 p-8 z-20">
            <p class="text-sky font-semibold uppercase tracking-wider text-sm mb-2">02 / Comfort</p>
            <h3 class="text-navy font-display text-2xl font-bold">{t(lang, "story.privateFleet")}</h3>
          </div>
        </div>

        <!-- Gallery Item 3 -->
        <div class="snap-center shrink-0 w-[85%] sm:w-[400px] h-[500px] bg-navy rounded-3xl relative overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-t from-navy to-transparent opacity-80 z-10"></div>
          <div class="absolute inset-0">
            <img src="/images/destinations/tumpak-sewu.jpg" alt="Tumpak Sewu" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-navy/20"></div>
          </div>
          <div class="absolute bottom-0 left-0 p-8 z-20">
            <p class="text-gold font-semibold uppercase tracking-wider text-sm mb-2">03 / Experience</p>
            <h3 class="text-offwhite font-display text-2xl font-bold">{t(lang, "story.localExpertise")}</h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-navy/10 pt-16">
    <h3 class="font-display text-3xl font-bold text-navy text-center mb-12">
      {lang === "en" ? "Trusted by Travelers" : "Dipercaya oleh Wisatawan"}
    </h3>
    <div class="flex flex-wrap justify-center gap-6">
      {testimonials.map((item) => (
        <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] flex">
          <TestimonialCard
            quote={lang === "en" ? item.data.quoteEn : item.data.quoteId}
            author={item.data.author}
            location={item.data.location}
            rating={item.data.rating}
            isPlaceholder={item.data.isPlaceholder}
            lang={lang}
          />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
