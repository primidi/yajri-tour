---
import { getCollection } from "astro:content";
import SectionSwitcher from "./prototype/SectionSwitcher.astro";
import VariantA from "./story-prototype/VariantA.astro";
import VariantB from "./story-prototype/VariantB.astro";
import VariantC from "./story-prototype/VariantC.astro";

interface Props {
  lang?: string;
}

const { lang = "id" } = Astro.props;

const testimonials = await getCollection("testimonials");
---

<section id="story" class="bg-offwhite py-20 px-4 sm:px-6 lg:px-8 relative group/section">
  <!-- IN-PLACE SECTION SWITCHER -->
  <SectionSwitcher 
    sectionKey="story" 
    sectionName="Story" 
    variants={[
      { id: "A", name: "Classic Story" },
      { id: "B", name: "Editorial Masonry" },
      { id: "C", name: "Interactive Gallery" }
    ]} 
  />

  <div class="mx-auto max-w-7xl relative z-10">
    <!-- PROTOTYPE VARIANTS -->
    <div class="prototype-variant" data-section="story" data-variant="A" style="display: none;">
      <VariantA testimonials={testimonials} lang={lang} />
    </div>
    
    <div class="prototype-variant" data-section="story" data-variant="B" style="display: none;">
      <VariantB testimonials={testimonials} lang={lang} />
    </div>
    
    <div class="prototype-variant" data-section="story" data-variant="C" style="display: none;">
      <VariantC testimonials={testimonials} lang={lang} />
    </div>
  </div>
</section>
