---
interface Props {
  features: Array<{ icon: string; titleId: string; titleEn: string; descId: string; descEn: string }>;
  lang: string;
}

const { features, lang } = Astro.props;
---

<div class="space-y-12 max-w-4xl mx-auto">
  {features.map((feat, index) => (
    <div class="group flex flex-col md:flex-row gap-6 md:gap-12 items-start md:items-center border-b border-navy/10 pb-12 last:border-0 last:pb-0">
      <div class="font-display text-6xl text-gold/20 font-light w-24 shrink-0 transition-colors duration-300 group-hover:text-gold">
        {(index + 1).toString().padStart(2, '0')}
      </div>
      <div class="flex-grow">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-navy mb-3 transition-colors duration-300 group-hover:text-sky">
          {lang === "en" ? feat.titleEn : feat.titleId}
        </h3>
        <p class="text-lg font-body text-charcoal/70 max-w-2xl leading-relaxed">
          {lang === "en" ? feat.descEn : feat.descId}
        </p>
      </div>
      <div class="hidden md:flex h-14 w-14 items-center justify-center rounded-full bg-navy text-offwhite shrink-0 opacity-0 group-hover:opacity-100 transition-all duration-500 transform group-hover:scale-110">
        <svg class="h-6 w-6 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d={feat.icon} />
        </svg>
      </div>
    </div>
  ))}
</div>
