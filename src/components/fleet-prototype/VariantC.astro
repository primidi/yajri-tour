---
import { t } from "../../i18n/utils";

interface Props {
  fleetItems: {
    type: string;
    capacity: string;
    desc: string;
    image: string;
  }[];
  lang?: string;
}

const { fleetItems, lang = "id" } = Astro.props;
---
<div class="max-w-7xl mx-auto">
  <div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-6 pb-8 -mx-4 px-4 sm:mx-0 sm:px-0">
    {fleetItems.map((item) => (
      <div class="min-w-[85vw] sm:min-w-[400px] max-w-[450px] shrink-0 snap-center bg-navy text-offwhite rounded-3xl overflow-hidden flex flex-col relative group hover:shadow-xl transition-shadow">
        <div class="aspect-4/3 bg-navy flex items-center justify-center relative overflow-hidden">
          <img src={item.image} alt={item.type} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/80 via-navy/20 to-transparent z-0"></div>
          <div class="absolute bottom-0 left-0 p-6 bg-gradient-to-t from-navy w-full z-10">
            <div class="inline-block px-3 py-1 bg-gold text-navy font-bold text-xs uppercase tracking-wider rounded font-body mb-2">
              {item.capacity}
            </div>
            <h3 class="font-display text-2xl font-bold text-offwhite">
              {item.type}
            </h3>
          </div>
        </div>
        <div class="p-8 pt-4 flex-1 flex flex-col">
          <p class="font-body text-offwhite/80 leading-relaxed text-sm mb-6 flex-1">
            {item.desc}
          </p>
          <div class="flex items-center justify-between border-t border-white/10 pt-4">
             <span class="text-xs font-body text-sky uppercase tracking-wider font-semibold">
               {lang === 'en' ? 'Private Vehicle' : 'Kendaraan Pribadi'}
             </span>
             <div class="h-8 w-8 rounded-full border border-gold flex items-center justify-center text-gold group-hover:bg-gold group-hover:text-navy transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
             </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
