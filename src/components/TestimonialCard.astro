---
import { t } from "../i18n/utils";

interface Props {
  quote: string;
  author: string;
  location?: string;
  rating?: number;
  isPlaceholder?: boolean;
  lang?: string;
}

const {
  quote,
  author,
  location,
  rating = 5,
  isPlaceholder = false,
  lang = "id",
} = Astro.props;
---

<div class="flex flex-col justify-between rounded-xl bg-white p-6 shadow-md border border-navy/10 relative">
  <div>
    {isPlaceholder && (
      <span class="mb-3 inline-block rounded bg-sky/10 px-2.5 py-1 text-xs font-semibold text-sky">
        {t(lang, "ui.travelerReview")}
      </span>
    )}

    <div class="flex items-center space-x-1 text-gold mb-4">
      {Array.from({ length: 5 }).map((_, index) => (
        <svg
          class={`h-5 w-5 ${index < rating ? "fill-gold text-gold" : "fill-gray-200 text-gray-200"}`}
          viewBox="0 0 20 20"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>

    <blockquote class="text-charcoal/90 italic font-body text-sm sm:text-base leading-relaxed">
      "{quote}"
    </blockquote>
  </div>

  <div class="mt-6 border-t border-gray-100 pt-4 flex items-center justify-between">
    <div>
      <p class="font-bold text-navy text-sm">{author}</p>
      {location && <p class="text-xs text-charcoal/60">{location}</p>}
    </div>
  </div>
</div>
